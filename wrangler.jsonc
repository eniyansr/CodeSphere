{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codesphere",
  "compatibility_date": "2026-06-28",

  // ─── Cloudflare Pages (Frontend) ─────────────────────────────────────────────
  "pages_build_output_dir": ".",

  // ─── Observability ───────────────────────────────────────────────────────────
  "observability": {
    "enabled": true
  },

  // ─── Compatibility ───────────────────────────────────────────────────────────
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // ─── Cloudflare D1 Database Binding ──────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codesphere-db",
      "database_id": "codesphere-d1-db"
    }
  ]
}
